{
  "manifest_version": 3,
  "name": "QuickKeys",
  "version": "1.0.0",
  "description": "Assign keyboard shortcuts for tab navigation, tab management, and a global dark mode toggle.",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "QuickKeys — click to toggle dark mode"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["tabs", "storage", "sessions"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-darkmode.js"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "commands": {
    "next-tab": {
      "suggested_key": { "default": "Alt+D" },
      "description": "Switch to the next tab"
    },
    "previous-tab": {
      "suggested_key": { "default": "Alt+A" },
      "description": "Switch to the previous tab"
    },
    "move-tab-right": {
      "suggested_key": { "default": "Alt+C" },
      "description": "Move the active tab one position right"
    },
    "move-tab-left": {
      "suggested_key": { "default": "Alt+Y" },
      "description": "Move the active tab one position left"
    },
    "toggle-dark-mode": {
      "description": "Toggle global dark mode on/off"
    },
    "close-tab": {
      "description": "Close the active tab"
    },
    "new-tab": {
      "description": "Open a new tab"
    },
    "reopen-closed-tab": {
      "description": "Reopen the last closed tab"
    },
    "pin-tab": {
      "description": "Pin or unpin the active tab"
    },
    "duplicate-tab": {
      "description": "Duplicate the active tab"
    }
  }
}
